# Henrik Valorant API configuration (required for crawler)
HENRIK_API_KEY=
HENRIK_RATE_LIMIT=90
RIOT_REGION=na

# Domain for Caddy automatic HTTPS (e.g. valostats.roshanarun.com)
DOMAIN=valostats.roshanarun.com

# Container settings
VALHEATMAP_DATA_DIR=/data
VALHEATMAP_READ_ONLY=0
VALHEATMAP_CRAWLER=1
